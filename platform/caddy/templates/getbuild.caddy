# Template → caddy/sites/getbuild.caddy. Hosts from caddy/sites.<env>.yml.

{{WEB_HOST}} {
	import security
	import compress
	reverse_proxy getbuild-web:3000 {
	}
}

{{API_HOST}} {
	import security
	import compress
	request_body {
		max_size 32MB
	}
		reverse_proxy getbuild-api:3000 {
		transport http {
			read_timeout 120s # BOQ/PDF exports
		}
	}
}
