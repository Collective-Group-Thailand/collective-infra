# Template → caddy/sites/getproperty.caddy (bin/render-sites.sh). Hosts from caddy/sites.<env>.yml.
# requires-file: sites/device-ca.pem
# requires-file: sites/device-broker.pem
# getproperty-api docs/deployment.md §4 is the source of these routes. Client IP (D-229): Caddy replaces
# X-Forwarded-For of untrusted (internet) clients and appends the peer, so every container sees exactly one
# trusted hop (TRUST_PROXY=1 / TRUSTED_HOPS=1).

# /internal/* (EMQX's HTTP authn/authz on getproperty-api, D-235) is docker-network only: never routed publicly.
(getproperty_internal_404) {
	@getproperty_internal path /internal /internal/*
	respond @getproperty_internal 404
}

(getproperty_common) {
	import security
	import compress
	import getproperty_internal_404
	# metrics are scraped by Alloy on the docker network, never through the public hosts
	respond /metrics 404
	respond /api/metrics 404
}

# Owner console, staff PWA, platform admin: one Next.js app, zones by host (getproperty-web)
{{OWNER_HOST}}, {{STAFF_HOST}}, {{ADMIN_HOST}} {
	import getproperty_common
	reverse_proxy getproperty-web:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up -X-Client-Cert-Sha256
		transport http {
			read_timeout 60s
		}
	}
}

# Resident LINE Mini App (getproperty-liff)
{{LIFF_HOST}} {
	import getproperty_common
	reverse_proxy getproperty-liff:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up -X-Client-Cert-Sha256
	}
}

# Public API: browsers' presigned-upload flows, LINE / payment webhooks, the BFFs' fallback. Never the device mTLS
# header: only DEVICE_HOST may set it.
{{API_HOST}} {
	import getproperty_common
	request_body {
		max_size 32MB # files go to S3 by presigned URL; this is the ceiling for everything else
	}
	reverse_proxy getproperty-api:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up -X-Client-Cert-Sha256
		transport http {
			read_timeout 120s # PDF endpoints
		}
	}
}

# Gateways (getproperty-edge) over HTTPS: bootstrap (one-time code, no certificate yet), certificate renewal and the
# device endpoints with their X.509 client certificate. Caddy verifies a presented certificate against the
# platform device CA (collective/<env>/platform/device-ca, rendered by bin/render-device-ca.sh) and forwards only its SHA-256;
# the API (DEVICE_MTLS_SOURCE=sha256_header) refuses /v1/device/* calls that need mTLS without it.
{{DEVICE_HOST}} {
	tls {
		client_auth {
			mode verify_if_given
			trust_pool file /etc/caddy/sites/device-ca.pem
		}
	}
	import security
	import getproperty_internal_404
	respond /metrics 404
	# OTA artefacts (getproperty-api D-231, deployment.md §5a): streamed by the API from the private bucket
	# (releases/edge/…) to the authenticated gateway; GET/HEAD only and a long upstream read timeout because the
	# download is paced by the building's uplink. Must stay before @device (handle blocks run in written order).
	@ota_artifact {
		path /v1/device/ota/artifacts/*
		method GET HEAD
	}
	handle @ota_artifact {
		reverse_proxy getproperty-api:3000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Client-Cert-Sha256 {http.request.tls.client.fingerprint}
			transport http {
				read_timeout 10m
			}
		}
	}
	@device path /v1/device/* /health
	handle @device {
		request_body {
			max_size 8MB
		}
		reverse_proxy getproperty-api:3000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Client-Cert-Sha256 {http.request.tls.client.fingerprint}
			transport http {
				read_timeout 60s
			}
		}
	}
	handle {
		respond 404
	}
}

# MQTT_HOST: DNS name of the broker. MQTT itself is EMQX's mTLS listener on :8883 (published by the platform compose
# file). On 443 this site is the WSS fallback for buildings that block 8883 (getproperty O-012, resolved 2026-10-21 as
# recommended): wss://{{MQTT_HOST}}/mqtt → EMQX ws listener, where the gateway authenticates with its device JWT alone
# (no client certificate on this path; EMQX HTTP authn on getproperty-api). The site serves the device-CA broker
# certificate (bin/render-device-ca.sh), not Let's Encrypt, so gateways verify 8883 and WSS against the same
# caChainPem of their bootstrap. Set MQTT_PUBLIC_WS_URL=wss://{{MQTT_HOST}}/mqtt in getproperty/app to offer it.
{{MQTT_HOST}} {
	tls /etc/caddy/sites/device-broker.pem /etc/caddy/sites/device-broker.key
	import security
	import getproperty_internal_404
	handle /mqtt {
		reverse_proxy platform-emqx-1:8083 {
			# a Caddy reload (render-sites.sh) keeps open WebSockets for 10 min instead of dropping every gateway at once
			stream_close_delay 10m
		}
	}
	handle /health {
		respond "getproperty mqtt: mqtts://{{MQTT_HOST}}:8883 (mTLS), wss://{{MQTT_HOST}}/mqtt (device JWT)" 200
	}
	handle {
		respond 404
	}
}
