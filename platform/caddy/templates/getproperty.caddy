# Template → caddy/sites/getproperty.caddy (bin/render-sites.sh). Hosts from caddy/sites.<env>.yml.
# Device hosts (DEVICE_HOST, MQTT_HOST) live in getproperty-device.caddy: they wait for the platform device CA.
# getproperty-api docs/deployment.md §4 is the source of these routes. Client IP (D-229): Caddy replaces
# X-Forwarded-For of untrusted (internet) clients and appends the peer, so every container sees exactly one
# trusted hop (TRUST_PROXY=1 / TRUSTED_HOPS=1).

# Docker-network-only paths of getproperty-api, never routed publicly (404 on every getproperty host):
#  - /internal/* — EMQX's HTTP authn/authz (D-235, D-244);
#  - /webhooks/integration/* — signed events from the other Collective products on this box (D-238, D-247), which
#    post to http://getproperty-api:3000/webhooks/integration/<getbuild|getpack> over the `collective` network. A
#    partner on another box does not get this route opened: it uses the SNS/SQS transport (D-238,
#    INTEGRATION_<P>_TRANSPORT=sns, Terraform products.<p>.enable_sqs).
(getproperty_internal_404) {
	@getproperty_internal path /internal /internal/* /webhooks/integration /webhooks/integration/*
	respond @getproperty_internal 404
}

(getproperty_common) {
	import security
	import compress
	import getproperty_internal_404
	# metrics are scraped by Alloy on the docker network, never through the public hosts
	respond /metrics 404
	respond /api/metrics 404
}

# Owner console, staff PWA, platform admin: one Next.js app, zones by host (getproperty-web). MARKETING_HOST is the
# platform's public site on the same app: getproperty-web serves the marketing pages there and 308s the rest to
# OWNER_HOST (its MARKETING_HOST env, from the secret's WEB__MARKETING_HOST).
{{MARKETING_HOST}}, {{OWNER_HOST}}, {{STAFF_HOST}}, {{ADMIN_HOST}} {
	import getproperty_common
	reverse_proxy getproperty-web:3000 {
		header_up -X-Client-Cert-Sha256
		transport http {
			read_timeout 60s
		}
	}
}

# Resident LINE Mini App (getproperty-liff)
{{LIFF_HOST}} {
	import getproperty_common
	reverse_proxy getproperty-liff:3000 {
		header_up -X-Client-Cert-Sha256
	}
}

# Public API: browsers' presigned-upload flows, LINE / payment webhooks, the BFFs' fallback. Never the device mTLS
# header: only DEVICE_HOST may set it. Not /internal/* or /webhooks/integration/* (getproperty_internal_404).
{{API_HOST}} {
	import getproperty_common
	request_body {
		max_size 32MB # files go to S3 by presigned URL; this is the ceiling for everything else
	}
	reverse_proxy getproperty-api:3000 {
		header_up -X-Client-Cert-Sha256
		transport http {
			read_timeout 120s # PDF endpoints
		}
	}
}
