# Non-secret compose knobs for uat (t4g.large, 8 GB). Read by bin/lib.sh after /etc/collective/platform.env, by both the
# platform and every product project. The product limits stay those of prod (UAT proves them under load); the sum of all
# ceilings exceeds 8 GB, which is accepted on UAT because limits are ceilings, not reservations — PostgreSQL is the
# one service sized down here.
POSTGRES_MEMORY_LIMIT=2g
CLAMAV_MEMORY_LIMIT=1152m

# getproperty PDFs (getproperty-api D-236, O-015 resolved 2026-10-21 as recommended, ADR-0012): own Chromium in the
# worker with 1.5 GB until getpack's pdf-render consumer is deployed; then `queue` + 512M (the budget line 1,792 MB).
# `queue` reads PDF_RENDER_REDIS_URL (Valkey DB 15, written by products/getproperty/hooks/post-secrets.sh).
GETPROPERTY_PDF_RENDERER_MODE=real
GETPROPERTY_WORKER_MEMORY=1536M
