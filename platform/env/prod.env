# Non-secret compose knobs for prod (t4g.xlarge, 16 GB). Read by bin/lib.sh after /etc/collective/platform.env, by
# both the platform and every product project, so a value here is reviewed in a PR like any other change.
# Empty = the compose default (the locked budget: platform ≈ 6 GB, getpack 3.2 GB, getproperty ≈ 1.8 GB, getpop ≈ 1.5 GB).
POSTGRES_MEMORY_LIMIT=3328m
CLAMAV_MEMORY_LIMIT=1152m
